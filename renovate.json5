{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>a7d-corp/renovate-presets:default.json5",
    "github>a7d-corp/renovate-presets:ansible.json5"
  ],
  "labels": ["skip-verify-changelog"],
  "ansible": {
    // whitelist specific files
    "fileMatch": [
      "^deploy.yaml"
    ]
  }
}
